# ============================================
# Trading Path Builder - .gitignore
# Comprehensive ignore patterns for GitHub
# ============================================

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# Python
# ============================================
# Virtual Environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/
backend/ENV/
*.venv

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc
*.pyo
*.pyd

# Python Distribution / Packaging
*.egg
*.egg-info/
dist/
build/
*.whl
pip-wheel-metadata/
share/python-wheels/

# Python Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Python Type Checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# Jupyter Notebook
.ipynb_checkpoints

# ============================================
# Node.js / Frontend
# ============================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
frontend/build/
frontend/dist/
frontend/.next/
frontend/out/
frontend/.cache/

# React / Create React App
frontend/.DS_Store
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Testing
coverage/
.nyc_output/
*.lcov

# Package Manager Locks
# NOTE: package-lock.json SHOULD be committed for reproducible builds
# Only ignore if you're using a different package manager
# package-lock.json  # Keep this committed!
# yarn.lock
# pnpm-lock.yaml

# ============================================
# Database Files
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
dev.db
backend/dev.db
*.sql
!backend/database/schema.sql

# ============================================
# Logs
# ============================================
logs/
*.log
backend/logs/
backend/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# ============================================
# IDE / Editor Files
# ============================================
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA / PyCharm
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# Build Artifacts
# ============================================
dist/
build/
*.egg-info/
*.egg
out/
.target/

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*~
.cache/

# ============================================
# Security & Keys
# ============================================
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
.secrets/

# ============================================
# Project Specific
# ============================================
# Data files (uncomment if containing sensitive data)
# backend/data/plans.json
# backend/data/users.json

# Test files (if you don't want to commit test outputs)
test-results/
test-output/

# ============================================
# Misc
# ============================================
*.zip
*.tar.gz
*.rar
*.7z

# Local configuration files
local_settings.py
local_config.py

# ============================================
# End of .gitignore
# ============================================
